# Copy this file to .env and fill in your own values before running the server.

# Port the API server listens on
PORT=4000

# Secret used to sign admin login tokens. Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Admin login credentials (used the first time the database is seeded)
ADMIN_EMAIL=admin@ibglobalfashion.com
ADMIN_PASSWORD=ChangeMe123!

# Shown to customers as the shop's WhatsApp contact number (include country code, no + or spaces)
SHOP_WHATSAPP_NUMBER=2348000000000

# Allowed origin for the frontend during development
CLIENT_ORIGIN=http://localhost:5173
